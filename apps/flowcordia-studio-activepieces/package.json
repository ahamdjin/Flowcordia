{
  "name": "@flowcordia/studio-activepieces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/run-with-activepieces-tsconfig.mjs vite build --config vite.config.mts",
    "copy:webapp": "node scripts/copy-to-webapp.mjs",
    "dev": "node scripts/run-with-activepieces-tsconfig.mjs vite --config vite.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.bridge.json && tsc --noEmit -p tsconfig.host.json",
    "test": "vitest run --exclude \"e2e/**\"",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@activepieces/core-execution": "workspace:*",
    "@activepieces/core-utils": "workspace:*",
    "@activepieces/pieces-framework": "workspace:*",
    "@activepieces/shared": "workspace:*",
    "@flowcordia/workflow": "workspace:*",
    "@tanstack/react-query": "5.51.1",
    "@xyflow/react": "12.3.5",
    "i18next": "23.13.0",
    "i18next-browser-languagedetector": "8.0.0",
    "i18next-http-backend": "3.0.5",
    "i18next-icu": "2.3.0",
    "lucide-react": "0.576.0",
    "react": "19",
    "react-dom": "19",
    "react-i18next": "15.0.1",
    "react-router-dom": "6.11.2",
    "socket.io-client": "4.8.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.36.2",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "20.14.14",
    "@types/react": "18.2.69",
    "@types/react-dom": "18.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.5.4",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}